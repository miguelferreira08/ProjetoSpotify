{
  "id": "./",
  "name": "RedBeat",
  "short_name": "RedBeat",
  "description": "RedBeat — catálogo, biblioteca, playlists e sugestões de músicas.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#070707",
